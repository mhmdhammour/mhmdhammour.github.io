---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import credentials from '../content/credentials/credentials.json';

const categories = ['Category 1', 'Category 2', 'Category 3'].map((c) => ({
  category: c,
  items: credentials.ibWorkshops.filter((w) => w.category === c),
}));
---
<Base title="Credentials" description="Mohammad Hammour's degrees, IB workshops across all three categories, leadership programs, and wellbeing and safeguarding certificates.">
  <PageHeader identity="The Lifelong Learner" title="Credentials" lede="Degrees, IB workshops, and the programs I have completed to keep growing as a teacher and a leader." />

  <section class="section" aria-labelledby="degrees-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Degrees</p>
        <h2 id="degrees-heading">Education</h2>
      </div>
      <ol class="degrees">
        {credentials.degrees.map((d) => (
          <li class="card">
            <p class="when">{d.years}</p>
            <h3>{d.title}</h3>
            <p class="muted">{d.institution} · {d.location}</p>
            <ul>{d.notes.map((n) => <li>{n}</li>)}</ul>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="ib-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">IB professional development</p>
        <h2 id="ib-heading">IB workshops</h2>
        <p>Completed across all three workshop categories.</p>
      </div>
      <div class="cats">
        {categories.map((c) => (
          <div class="card">
            <p class="eyebrow">{c.category}</p>
            <ul class="list">{c.items.map((i) => <li>{i.title}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  {credentials.groups.map((g, gi) => (
    <section class="section" aria-labelledby={`group-${gi}`}>
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Certificates</p>
          <h2 id={`group-${gi}`}>{g.title}</h2>
        </div>
        <ul class="certs">
          {g.items.map((i) => (
            <li>
              <span class="cert-title">{i.title}</span>
              <span class="muted">{i.provider}{'status' in i && i.status && <span class="tag">{i.status}</span>}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <section class="section section--tint" aria-labelledby="languages-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Languages</p>
        <h2 id="languages-heading">Arabic and English</h2>
      </div>
      <ul class="certs">
        {credentials.languages.map((l) => <li><span class="cert-title">{l.language}</span><span class="muted">{l.level}</span></li>)}
      </ul>
      <p class="muted note">Certificates available on request.</p>
    </div>
  </section>
</Base>

<style>
  .degrees { list-style: none; padding: 0; display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
  .degrees ul { padding-left: 1.1rem; display: grid; gap: var(--space-1); }
  .degrees li li::marker { color: var(--maroon); }
  .when { color: var(--maroon); font-weight: 600; font-size: var(--text-sm); }
  .cats { display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); }
  .list { list-style: none; padding: 0; display: grid; gap: var(--space-2); }
  .certs { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); column-gap: var(--space-7); }
  .certs li { display: grid; gap: 0.1rem; padding-block: var(--space-3); border-bottom: 1px solid var(--line); }
  .cert-title { font-weight: 600; }
  .certs .tag { margin-left: var(--space-2); }
  .note { margin-top: var(--space-5); }
</style>
