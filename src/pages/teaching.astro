---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Ext from '../components/Ext.astro';
import Todo from '../components/Todo.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import RingDivider from '../components/RingDivider.astro';
import philosophy from '../content/philosophy.json';
import { formatRange, isTodo } from '../lib/format';
import { site } from '../site.config';

const snapshots = (await getCollection('snapshots')).sort((a, b) => a.data.order - b.data.order);
// With TODOs hidden, a project shows only once at least one of its fields is filled in.
const projects = (await getCollection('projects'))
  .filter((p) => site.showTodos || p.data.image || ![p.data.context, p.data.studentsDid, p.data.learning].every((f) => isTodo(f)))
  .sort((a, b) => a.data.order - b.data.order);
const roles = (await getCollection('roles', (r) => !r.data.draft && (r.data.group === 'school' || r.data.group === 'earlier')))
  .sort((a, b) => a.data.order - b.data.order);
---
<Base title="Teaching" description="Mohammad Hammour's teaching philosophy, classroom practice in the PYP, featured units, and current Grade 5 role at Qatar Foundation.">
  <PageHeader identity="The Educator" title="Teaching" lede="My classroom is my learning lab. It is where I test ideas about inquiry before I share them with other educators." />

  <section class="section" aria-labelledby="current-heading">
    <div class="wrap current">
      <div class="section-head">
        <p class="eyebrow">Now</p>
        <h2 id="current-heading">Grade 5 at Qatar Foundation</h2>
      </div>
      <div class="prose">
        <p>I teach Grade 5 in the Primary Years Programme at <Ext href="https://www.qf.org.qa/">Qatar Foundation</Ext>, covering units of inquiry, language, and writing.</p>
        <p>Literacy is a major focus. I run leveled RWI Fresh Start groups and individualized language support to close gaps for students with diverse academic and behavioral needs.</p>
        <p>I also prepare my students for the PYP Exhibition, guiding them through the culminating inquiry of the program.</p>
      </div>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="philosophy-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Philosophy</p>
        <h2 id="philosophy-heading">What I believe learning needs</h2>
        <p>{philosophy.intro}</p>
      </div>
      <ol class="values">
        {philosophy.values.map((v, i) => (
          <li class="value">
            <span class="num" aria-hidden="true">{i + 1}</span>
            <div>
              <h3>{v.title}</h3>
              {isTodo(v.text) ? <Todo text={v.text} /> : <p>{v.text}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="snapshots-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Classroom snapshots</p>
        <h2 id="snapshots-heading">What inquiry looks like in my classroom</h2>
        <p>Eight practices I return to across units, photographed at Arab International Academy.</p>
      </div>
      <ul class="snapshots">
        {snapshots.map((s, i) => (
          <li class="card snapshot">
            <Image src={s.data.image} alt={s.data.alt} widths={[400, 640, 800]} sizes="(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 270px"
              width={800} height={600} fit="cover" class="photo" format="webp" quality={72} loading={i < 2 ? 'eager' : 'lazy'} />
            <h3>{s.data.title}</h3>
            <p class="muted">{s.data.caption}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <RingDivider />

  {projects.length > 0 && <section class="section" aria-labelledby="projects-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Featured units and projects</p>
        <h2 id="projects-heading">Units in depth</h2>
        <p>Three pieces of work from Arab International Academy, each told as a short case study.</p>
      </div>
      <div class="projects">
        {projects.map((p) => (
          <article class="project card">
            <div class="project-media">
              {p.data.image
                ? <Image src={p.data.image} alt={p.data.imageAlt ?? ''} width={800} height={600} fit="cover" class="photo" format="webp" quality={72} />
                : <PhotoPlaceholder label={p.data.photoNeeded} />}
            </div>
            <div class="project-body">
              <p class="eyebrow">{p.data.school}</p>
              <h3>{p.data.title}</h3>
              <dl>
                {(!isTodo(p.data.context) || site.showTodos) && <div><dt>Context</dt><dd>{isTodo(p.data.context) ? <Todo text={p.data.context} /> : p.data.context}</dd></div>}
                {(!isTodo(p.data.studentsDid) || site.showTodos) && <div><dt>What students did</dt><dd>{isTodo(p.data.studentsDid) ? <Todo text={p.data.studentsDid} /> : p.data.studentsDid}</dd></div>}
                {(!isTodo(p.data.learning) || site.showTodos) && <div><dt>What it showed about their learning</dt><dd>{isTodo(p.data.learning) ? <Todo text={p.data.learning} /> : p.data.learning}</dd></div>}
              </dl>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>}

  <section class="section section--tint" aria-labelledby="career-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Experience</p>
        <h2 id="career-heading">Where I have taught</h2>
      </div>
      <ol class="timeline">
        {roles.map((r) => (
          <li>
            <p class="when">{r.data.start && formatRange(r.data.start, r.data.end === 'present' ? undefined : r.data.end)}</p>
            <div>
              <h3>{r.data.title}</h3>
              <p class="org">{r.data.orgUrl ? <Ext href={r.data.orgUrl}>{r.data.org}</Ext> : r.data.org}{r.data.location && <span class="muted"> · {r.data.location}</span>}</p>
              <ul>{r.data.highlights.map((h) => <li>{h}</li>)}</ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  .values { list-style: none; padding: 0; display: grid; gap: var(--space-4); max-width: 60rem; }
  .value { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-5); background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: var(--space-5); align-items: start; }
  .value > div { display: grid; grid-template-columns: minmax(0, 15rem) minmax(0, 1fr); gap: var(--space-2) var(--space-6); }
  @media (max-width: 760px) { .value > div { grid-template-columns: 1fr; } }
  .num {
    width: 2.25rem; height: 2.25rem; border-radius: 50%;
    display: grid; place-items: center;
    border: 1.5px solid var(--maroon); color: var(--maroon);
    font-family: var(--font-display); font-weight: 600;
    box-shadow: 0 0 0 4px var(--white), 0 0 0 5px var(--line);
  }

  .snapshots { list-style: none; padding: 0; display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); }
  .snapshot { padding: var(--space-3); padding-bottom: var(--space-5); }
  .snapshot h3, .snapshot p { padding-inline: var(--space-2); }
  .snapshot p { font-size: 0.95rem; }

  .projects { display: grid; gap: var(--space-5); }
  .project { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: var(--space-6); align-items: start; }
  .project-body { display: grid; gap: var(--space-3); }
  dl { margin: 0; display: grid; gap: var(--space-3); }
  dt { font-weight: 600; font-size: var(--text-sm); color: var(--maroon-deep); }
  dd { margin: var(--space-1) 0 0; }
  @media (max-width: 760px) { .project { grid-template-columns: 1fr; } }

  .timeline { list-style: none; padding: 0; display: grid; gap: 0; }
  .timeline > li { display: grid; grid-template-columns: 13rem minmax(0, 1fr); gap: var(--space-5); padding-block: var(--space-5); border-bottom: 1px solid var(--line); }
  .timeline > li:last-child { border-bottom: 0; }
  .when { color: var(--muted); font-size: var(--text-sm); font-variant-numeric: tabular-nums; padding-top: 0.2rem; }
  .org { margin-top: var(--space-1); }
  .timeline ul { margin-top: var(--space-3); padding-left: 1.1rem; display: grid; gap: var(--space-2); max-width: var(--measure); }
  .timeline li li::marker { color: var(--maroon); }
  @media (max-width: 640px) { .timeline > li { grid-template-columns: 1fr; gap: var(--space-2); } }
</style>
