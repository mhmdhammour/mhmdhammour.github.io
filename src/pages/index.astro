---
import Base from '../layouts/Base.astro';
import Headshot from '../components/Headshot.astro';
import RingDivider from '../components/RingDivider.astro';
import { site } from '../site.config';

const proofs = [
  {
    stat: 'Nearly 700 educators',
    text: 'Co-facilitated the virtual IBEN webinar on Theory U, "Opening Mind, Heart, and Will," in September 2026.',
    href: '/leadership/#workshops',
    more: 'See my workshops',
  },
  {
    stat: 'Three consecutive IB Days',
    text: 'Presented at the Qatar IB Association of Schools IB Day each year from 2023 to 2025.',
    href: '/leadership/#workshops',
    more: 'See the sessions',
  },
  {
    stat: 'M.Ed. research on accreditation',
    text: 'A case study of how school leadership responds to external accreditation reports.',
    href: '/writing/#thesis',
    more: 'Read about the thesis',
  },
];

// The five identities from the original portfolio, each pointing to where that work lives now.
const identities = [
  { name: 'The Educator', href: '/teaching/', text: 'My teaching philosophy, classroom practice, and featured units.' },
  { name: 'The Trainer', href: '/leadership/', text: 'Coordination, external roles, and the workshops I have led.' },
  { name: 'The Writer', href: '/writing/#writing', text: 'Articles and an interview on learning and teaching, published in Arabic.' },
  { name: 'The Researcher', href: '/writing/#thesis', text: 'My M.Ed. dissertation on accreditation and school improvement.' },
  { name: 'The Lifelong Learner', href: '/credentials/', text: 'Degrees, IB workshops, and professional certificates.' },
];
---
<Base title={site.name} description="Mohammad Hammour is a PYP educator in Doha, an IBEN Workshop Leader, and a CIS Evaluator. Teaching, leadership, writing, and credentials.">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text fade-in">
        <p class="eyebrow">{site.descriptor}</p>
        <h1>Mohammad Hammour</h1>
        <p class="tagline">{site.tagline}</p>
        <div class="intro">
          <p>I am a Lebanese PYP educator based in Doha. I teach Grade 5 at Qatar Foundation, and before that I taught Grades 4 and 5 at Arab International Academy, where I also served as PYP Math Coordinator.</p>
          <p>I work with colleagues on collaborative planning, assessment moderation, and readiness for IB evaluation. As an IBEN Workshop Leader and CIS Evaluator, I see how programs are judged from the outside, and I bring that view back into daily practice.</p>
        </div>
        <div class="btn-row">
          <a class="btn" href="/teaching/">See my teaching</a>
          <a class="btn btn--ghost" href={site.cv} download>Download CV</a>
        </div>
      </div>
      <div class="hero-photo">
        <Headshot size={300} eager />
      </div>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="proof-heading">
    <div class="wrap">
      <h2 id="proof-heading" class="sr-only">Highlights</h2>
      <ul class="grid grid--3 plain">
        {proofs.map((p) => (
          <li>
            <a class="card card--link proof" href={p.href}>
              <p class="stat">{p.stat}</p>
              <p class="muted">{p.text}</p>
              <span class="more">{p.more} →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <RingDivider />

  <section class="section identities" aria-labelledby="explore-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Explore</p>
        <h2 id="explore-heading">Five sides of my work</h2>
      </div>
      <ul class="identity-grid plain">
        {identities.map((i) => (
          <li>
            <a class="card card--link" href={i.href}>
              <h3>{i.name}</h3>
              <p class="muted">{i.text}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero { overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: var(--space-6); align-items: center; padding-block: var(--space-8); }
  .hero-text { display: grid; gap: var(--space-4); }
  .tagline { font-family: var(--font-display); font-size: var(--text-lg); line-height: 1.35; color: var(--maroon-deep); max-width: 30ch; }
  .intro { display: grid; gap: var(--space-3); max-width: 58ch; color: var(--ink); }
  .hero-text .btn-row { margin-top: var(--space-2); }
  .hero-photo { display: grid; place-items: center; }
  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; padding-block: var(--space-6) var(--space-7); }
    .hero-photo { order: -1; }
  }
  .plain { list-style: none; padding: 0; }
  .plain > li { display: grid; }
  .stat { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 600; color: var(--maroon); line-height: 1.2; }
  .identities h3 { color: var(--maroon-deep); }
  .identity-grid { display: grid; gap: var(--space-4); grid-template-columns: repeat(5, minmax(0, 1fr)); }
  @media (max-width: 1000px) { .identity-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .identity-grid > li:last-child { grid-column: 1 / -1; } }
  @media (max-width: 560px) { .identity-grid { grid-template-columns: 1fr; } }
</style>
