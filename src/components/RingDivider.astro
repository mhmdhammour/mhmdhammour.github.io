---
// Section divider built from the ring motif.
---
<div class="ring-divider" aria-hidden="true">
  <svg viewBox="0 0 120 24" width="120" height="24">
    <circle cx="60" cy="12" r="10.5" fill="none" stroke="var(--maroon)" stroke-opacity="0.35" stroke-width="1.25" />
    <circle cx="60" cy="12" r="6.5" fill="none" stroke="var(--maroon)" stroke-opacity="0.55" stroke-width="1.25" />
    <circle cx="60" cy="12" r="2.5" fill="var(--maroon)" />
    <line x1="0" y1="12" x2="44" y2="12" stroke="var(--line)" stroke-width="1" />
    <line x1="76" y1="12" x2="120" y2="12" stroke="var(--line)" stroke-width="1" />
  </svg>
</div>
<style>
  .ring-divider { display: flex; justify-content: center; padding-block: var(--space-5); }
  .ring-divider svg { width: min(320px, 70%); height: auto; }
</style>
